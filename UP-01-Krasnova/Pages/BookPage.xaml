<Page x:Class="UP_01_Krasnova.Pages.BookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP_01_Krasnova.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="150"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45"></ColumnDefinition>
            <ColumnDefinition Width="120"></ColumnDefinition>
            <ColumnDefinition Width="180"></ColumnDefinition>
            <ColumnDefinition Width="300"></ColumnDefinition>
            <ColumnDefinition Width="100"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Страница книги" FontSize="16" Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </StackPanel>

        <Image x:Name="CoverImg" Source="/Images/Image.PNG" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2"/>

        <StackPanel Grid.Column="3" Grid.Row="1">
            <TextBlock x:Name="NameTB" Text="Название: " Margin="10"/>
            <TextBlock x:Name="DescriptionTB" Text="Описание: " Margin="10,0,10,10"/>
            <TextBlock x:Name="AuthorTB" Text="Автор: " Margin="10,0,10,10"/>
            <TextBlock x:Name="GenresTB" Text="Жанры: " Margin="10,0,10,10"/>
            <TextBlock x:Name="RatingTB" Text="Рейтинг: " Margin="10,0,10,10"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="3" VerticalAlignment="Center">
            <Button x:Name="ReadBtn" Content=" Читать" Width="100" Margin="10"/>
            <!--Margin="10,0,10,10"-->
            <Menu x:Name="ReportMenu" Margin="10,0,10,10">
                <MenuItem Header="Пожаловаться" Width="100" Height="20" Background="#dddddd" BorderBrush="Black" BorderThickness="1">
                    <MenuItem x:Name="ReportBookMI" Header="На книгу"/>
                    <MenuItem x:Name="ReportAuthorMI" Header="На автора"/>
                </MenuItem>
            </Menu>
            <Menu x:Name="FrozeMenu" Margin="10,0,10,10" Visibility="Collapsed">
                <MenuItem Header="Заморозить" Width="100" Height="20" Background="#dddddd" BorderBrush="Black" BorderThickness="1">
                    <MenuItem x:Name="FrozeBookMI" Header="Книгу"/>
                </MenuItem>
            </Menu>
        </StackPanel>

        <StackPanel Grid.Column="2" Grid.Row="3" Grid.ColumnSpan="2">
            <TextBlock Text="Отзывы" HorizontalAlignment="Center"/>
                <ListBox x:Name="ReviewsLB" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center" Margin="10" Height="130" Width="460">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="220" Width="128" Margin="0">
                            <StackPanel Margin="0">
                                <Image Source="/Images/Image.PNG" Width="100" Height="100" Margin="10" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Name, StringFormat=Название: {0}}" Margin="10, 0, 10, 10" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding TotalRating, StringFormat=Рейтинг: {0}/10}" Margin="10, 0, 10, 10" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding User.Username, StringFormat=Автор: {0}}" Margin="10, 0, 10, 10" HorizontalAlignment="Center"/>
                                <Button x:Name="AddToListBtn" Content="Добавить в список"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </StackPanel>
    </Grid>
</Page>
