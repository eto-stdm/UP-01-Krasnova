<Page x:Class="UP_01_Krasnova.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP_01_Krasnova.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="100"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45"></ColumnDefinition>
            <ColumnDefinition Width="300"></ColumnDefinition>
            <ColumnDefinition Width="300"></ColumnDefinition>
            <ColumnDefinition Width="100"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Профиль" FontSize="16" Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="UsernameTB" Text="Имя: " Margin="10"/>
                <TextBlock x:Name="LoginTB" Text="Логин: " Margin="0,10,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="EmailTB" Text="Электронная почта: " Margin="10,0,10,10"/>
                <TextBlock x:Name="RoleTB" Text="Роль: " Margin="0,0,10,10"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Center">
            <TextBlock Text="Просмотр отзывов" HorizontalAlignment="Center" FontSize="16" Margin="0,10,0,0"/>
            <ListBox x:Name="ReviewsLB" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center" Margin="10" Height="130" Width="580">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="50" Width="570" Margin="0">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Book.Name, StringFormat=Название: {0}}" Margin="10"/>
                                <TextBlock Text="{Binding Rating, StringFormat=Рейтинг: {0}}" Margin="0, 10, 10, 10"/>
                                <TextBlock Text="{Binding Text, StringFormat=Описание: {0}}" Margin="0, 10, 10, 10"/>
                                <TextBlock Text="{Binding Date, StringFormat=Дата: dd.MM.yyyy}" Margin="0, 10, 10, 10"/>
                            </WrapPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </StackPanel>

        <StackPanel x:Name="BecomeAuthorSP" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden">
            <TextBlock Text="Хотите стать автором?&#10;Вы можете подать завяку прямо здесь" TextWrapping="Wrap" Margin="10,0,10,0"/>
            <Button x:Name="BecomeAuthorBtn" Content="Подать заявку" Margin="10"/>
        </StackPanel>

        <StackPanel x:Name="UnfreezeAccSP" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden">
            <TextBlock x:Name="UnfreezeAccTB" Text="Ваш аккаунт заморожен.&#10;Причина: " TextWrapping="Wrap" Margin="10,0,10,0"/>
            <Button x:Name="UnfreezeAccBtn" Content="Оспорить заморозку" Margin="10"/>
        </StackPanel>
    </Grid>
</Page>
