<Page x:Class="UP_01_Krasnova.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP_01_Krasnova.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <TextBlock Text="ШутИКроль" Grid.Column="0" Grid.Row="0" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Grid.Row="0" Text="Читай, Пиши и не спиши" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <StackPanel Grid.Column="0" Grid.Row="1" Background="LightSlateGray">
            <Button x:Name="BookCatalogBtn" Height="60" Click="SideBarItem_Click">
                <Image Source="/Images/bookcatalog.png" Margin="5"/>
            </Button>
            <Button x:Name="BookListBtn" Height="60" Click="SideBarItem_Click">
                <Image Source="/Images/booklist.png" Margin="5"/>
            </Button>
            <Button x:Name="ProfileBtn" Height="60" Click="SideBarItem_Click">
                <Image Source="/Images/profile.png" Margin="5"/>
            </Button>
            <Button x:Name="AdminBtn" Height="60" Visibility="Collapsed" Click="SideBarItem_Click">
                <Image Source="/Images/admin.png" Margin="5"/>
            </Button>
            <Button x:Name="AuthorBtn" Height="60" Visibility="Collapsed" Click="SideBarItem_Click">
                <Image Source="/Images/author.png" Margin="5"/>
            </Button>
            <Button x:Name="WarningBtn" Height="60" Visibility="Collapsed" Click="SideBarItem_Click">
                <Image Source="/Images/warning.png" Margin="5"/>
            </Button>
            <Button x:Name="ExitBtn" Height="60" Visibility="Visible" Click="SideBarItem_Click">
                <Image Source="/Images/exit.png" Margin="5"/>
            </Button>
        </StackPanel>

        <Frame x:Name="MainPageFrame" Grid.Column="1" Grid.Row="1" NavigationUIVisibility="Hidden" Source="/Pages/BookCatalogPage.xaml"/>
    </Grid>
</Page>
