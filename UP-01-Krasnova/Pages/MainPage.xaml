<Page x:Class="UP_01_Krasnova.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP_01_Krasnova.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Grid.Row="0" Text="ШутИКроль" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Grid.Row="0" Text="Читай, Пиши и не спиши" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Menu Grid.Column="0" Grid.Row="1">
            <MenuItem x:Name="BookCatalogMI" Height="60" Click="SideBarItem_Click">
                <MenuItem.Header>
                    <Image Source="/Images/bookcatalog.png" Margin="10"/>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem x:Name="BookListMI" Width="100" Height="60" Click="SideBarItem_Click">
                <MenuItem.Header>
                    <Image Source="/Images/booklist.png" Margin="10"/>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem x:Name="ProfileMI" Width="100" Height="60" Click="SideBarItem_Click">
                <MenuItem.Header>
                    <Image Source="/Images/profile.png" Margin="10"/>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem x:Name="AdminMI" Width="100" Height="60" Click="SideBarItem_Click" Visibility="Collapsed">
                <MenuItem.Header>
                    <Image Source="/Images/admin.png" Margin="10"/>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem x:Name="AuthorMI" Width="100" Height="60" Click="SideBarItem_Click" Visibility="Collapsed">
                <MenuItem.Header>
                    <Image Source="/Images/author.png" Margin="10"/>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem x:Name="WarningMI" Width="100" Height="60" Click="SideBarItem_Click" Visibility="Collapsed">
                <MenuItem.Header>
                    <Image Source="/Images/warning.png" Margin="10"/>
                </MenuItem.Header>
            </MenuItem>
        </Menu>

        <Frame x:Name="MainPageFrame" Grid.Column="1" Grid.Row="1" NavigationUIVisibility="Hidden" Source="/Pages/BookCatalogPage.xaml"/>
    </Grid>
</Page>
