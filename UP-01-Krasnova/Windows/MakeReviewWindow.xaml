<Window x:Class="UP_01_Krasnova.Windows.MakeReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP_01_Krasnova.Windows"
        mc:Ignorable="d"
        Title="MakeReviewWindow" Height="200" Width="200">
    <Grid>
        <StackPanel>
            <TextBlock x:Name="BookNameTB" Text="Оставить отзыв на " HorizontalAlignment="Center" Margin="10" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Оценка:" Margin="10,0,10,10"/>
                <ComboBox x:Name="RatingCB" Margin="0,0,10,10" SelectedIndex="9"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Текст:" Margin="10,0,10,10"/>
                <TextBox x:Name="TextTB" Width="100" Margin="0,0,10,10"/>
            </StackPanel>
            <Button x:Name="MakeReviewBtn" Content="Выложить отзыв" Margin="10,0,10,10" Click="MakeReviewBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
