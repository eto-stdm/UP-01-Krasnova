<Window x:Class="UP_01_Krasnova.Windows.MakeEditBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP_01_Krasnova.Windows"
        mc:Ignorable="d"
        Title="MakeEditBookWindow" Height="330" Width="300">
    <Grid>
        <StackPanel>
            <TextBlock x:Name="HeaderTB" Text="Новая книга" HorizontalAlignment="Center" Margin="10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Название: " Margin="10"/>
                <TextBox x:Name="NameTB" Width="150" Margin="0,10,10,10"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Описание: " Margin="10"/>
                <TextBox x:Name="DescriptionTB" Width="150" Margin="0,10,10,10"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Жанры: " Margin="10"/>
                <ListBox x:Name="GenresLB" Background="#fffcfa" ItemsSource="{Binding Path=box}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Top" Margin="0,10,10,10" Width="150" Height="35">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="25" Width="120">
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding Check}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Текст книги: " Margin="10"/>
                <TextBox x:Name="TextTB" Width="150" Margin="0,10,10,10"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Обложка: " Margin="10"/>
                <TextBox x:Name="CoverTB" Width="150" Margin="0,10,10,10"/>
            </StackPanel>
            <Button x:Name="MakeEditBookBtn" Content="Создать книгу" Margin="10" Width="130" Click="MakeEditBookBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
