<Window x:Class="UP_01_Krasnova.Windows.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP_01_Krasnova.Windows"
        mc:Ignorable="d"
        Title="ChangePasswordWindow" Height="240" Width="200">
    <Grid>
        <StackPanel>
            <TextBlock Text="Смена пароля" HorizontalAlignment="Center" Margin="10"/>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Введите старый пароль:" Margin="10"/>
                <PasswordBox x:Name="OldPB" Width="150" Margin="10,0,10,10"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Введите новый пароль:" Margin="10"/>
                <PasswordBox x:Name="NewPB" Width="150" Margin="10,0,10,10"/>
            </StackPanel>
            <Button x:Name="ChangePasswordBtn" Content="Применить изменения" Width="140" Margin="10" Click="ChangePasswordBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
