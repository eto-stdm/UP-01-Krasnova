<Window x:Class="UP_01_Krasnova.Windows.WholeBookTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP_01_Krasnova.Windows"
        mc:Ignorable="d"
        Title="WholeBookTextWindow" Height="200" Width="200">
    <Grid>
        <StackPanel>
            <TextBlock x:Name="BookNameTB" Text="Текст книги " HorizontalAlignment="Center" Margin="10"/>
            <ScrollViewer Height="120" Margin="10,0,10,10">
                <TextBlock x:Name="WholeTextTB" HorizontalAlignment="Left" TextWrapping="Wrap"/>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Window>
